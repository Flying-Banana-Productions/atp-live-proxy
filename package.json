{
  "name": "atp-live-proxy",
  "version": "1.0.0",
  "description": "A proxy server for ATP tennis live API with caching capabilities",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:large": "node --max-old-space-size=4096 src/server.js",
    "start:xlarge": "node --max-old-space-size=8192 src/server.js",
    "dev": "nodemon src/server.js --ignore 'logs/*'",
    "dev:large": "nodemon --exec 'node --max-old-space-size=4096' src/server.js",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "replay": "node replay-events.js"
  },
  "keywords": [
    "atp",
    "tennis",
    "proxy",
    "api",
    "cache"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.20.0",
    "commander": "^14.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "json-diff-ts": "^4.10.4",
    "morgan": "^1.12.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
